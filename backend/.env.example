# Copy this file to .env and fill in real values. .env is git-ignored.

# Google Maps Platform key with "Places API (New)" enabled and billing on.
# Restrict the key to Places API (New) and set a daily quota cap in the Cloud Console.
GOOGLE_PLACES_API_KEY=

# Hard cap on the number of Places API calls the crawler may make (safety tripwire).
GOOGLE_PLACES_MAX_CALLS=4000

# CORS: comma-separated web origin(s) allowed to call this API in production,
# e.g. https://your-frontend.vercel.app  (localhost + Capacitor native origins
# are always allowed). Leave blank in local dev.
ALLOWED_ORIGINS=

# data.gov.sg and OneMap are keyless — no entries needed.
