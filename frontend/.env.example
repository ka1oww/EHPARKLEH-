# Copy this file to .env and adjust as needed. .env is git-ignored.
#
# Base URL of the EhParkLeh backend API (no trailing slash).
# Leave unset to use the deployed Render backend by default.
# For local development against a local backend, use:
#   VITE_API_BASE=http://localhost:8000
VITE_API_BASE=https://ehparkleh-backend.onrender.com
